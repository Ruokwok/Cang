import cang/io/Process
import cang/io/File
import cang/lang/System

# cangc — Cang 编译器启动器
# 布局约定（相对当前工作目录）：
#   <cwd>/jar/cang.jar          编译器 jar
#   <cwd>/openjdk/bin/java.exe  JVM（非 Windows 为 bin/java）
# 用法与 java -jar cang.jar 完全一致，退出码透传；
# -v 归一为 --version 后转发（打印编译器版本）；
# -h/--help 或无参数启动时打印本帮助（无参 exit 1，显式 help exit 0）。
class Main()

# ---- help / version 拦截（不需要 jar/JVM，最先处理） ----
bool showHelp = false
bool helpExplicit = false
int argCount = 0
for (var a : System.ARGS) {
    argCount = argCount + 1
}
if (argCount <= 1) {
    showHelp = true
} else {
    for (var a : System.ARGS) {
        if (a == "-h" || a == "--help") {
            showHelp = true
            helpExplicit = true
        }
    }
}
if (showHelp) {
    Stdout.println(`cangc — Cang compiler launcher

Usage:
  cangc <source.cang> [options]    compile a Cang program
  cangc -v | --version             print compiler version
  cangc -h | --help                show this help

Layout (relative to the current working directory):
  jar/cang.jar             compiler
  openjdk/bin/java(.exe)   JVM

Compiler options (forwarded to the compiler):
  --no-link            compile to .ll only (skip clang/gcc)
  --target <t>         windows | linux | macos   (default: windows)
  --clang <path>       clang executable
  --gcc <path>         gcc executable
  --gc / --no-gc       Boehm GC on (default) / manual free
  --gc-lib <dir>       override libgc lookup directory

The exit code is passed through from the compiler.`)
    if (helpExplicit) {
        System.exit(0)
    }
    System.exit(1)
}

String cwd = System.getCwd()
if (cwd == null) {
    Stderr.println("cangc: cannot resolve working directory")
    System.exit(2)
}

String jre = "openjdk/bin/java.exe"
if (System.OS_TYPE != "windows") {
    jre = "openjdk/bin/java"
}
String javaExe = cwd + "/" + jre
String jarPath = cwd + "/jar/cang.jar"

File javaFile = new File(javaExe)
if (!javaFile.exists()) {
    Stderr.println("cangc: JVM not found: " + javaExe)
    System.exit(3)
}
File jarFile = new File(jarPath)
if (!jarFile.exists()) {
    Stderr.println("cangc: compiler jar not found: " + jarPath)
    System.exit(4)
}

# cmd = [javaExe, "-jar", jarPath, <用户参数...>]
int n = 0
for (var a : System.ARGS) {
    n = n + 1
}
String[] cmd = new String[n + 2]
cmd[0] = javaExe
cmd[1] = "-jar"
cmd[2] = jarPath
bool first = true
int i = 2
for (var a : System.ARGS) {
    if (first) {
        first = false
    } else {
        i = i + 1
        cmd[i] = a
        if (a == "-v") {
            cmd[i] = "--version"
        }
    }
}

# 子进程 stdout 逐行转发；stderr 直接继承终端
Function<Void, String> cb = (line) -> {
    Stdout.println(line)
}
int code = Process.exec(cmd, cb, -1)
System.exit(code)
