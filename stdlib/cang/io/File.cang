namespace cang/io

# File - 文件对象，获取方式参考 Java：new File("src/abc.txt")
# 相对路径的根目录为程序运行目录（进程当前工作目录）。
class File(String path = "")

# 系统路径分隔符：windows 为 \ ，linux/macos 为 /
static final native String separator

# ---------- 路径信息 ----------

# 原始路径（构造时传入的字符串，不做任何转换）
native func String getPath()

# 最后一段名称（文件名或目录名）
native func String getName()

# 父目录路径；没有父目录时返回 null
native func String getParent()

# 绝对路径：相对路径基于程序运行目录拼接
native func String getAbsolutePath()

# 是否绝对路径（Windows: 盘符/UNC/反斜杠开头；Linux/macOS: / 开头）
native func bool isAbsolute()

# 把路径中的分隔符转换为当前系统风格（windows: \ ，linux/macos: /）
# 注意：linux 上反斜杠是合法文件名字符，此方法会显式替换，仅在需要跨平台路径时调用
native func String toSystemPath()

# ---------- 状态查询 ----------

# 路径是否存在（文件或目录）
native func bool exists()

# 是否普通文件
native func bool isFile()

# 是否目录
native func bool isDirectory()

# 文件字节数；不存在或无法打开时为 0
native func long length()

# ---------- 文件/目录操作 ----------

# 删除文件或空目录，成功返回 true
native func bool delete()

# 创建单级目录，成功返回 true（已存在返回 false）
native func bool mkdir()

# 递归创建目录（含父级），最终目录创建成功返回 true
native func bool mkdirs()

# 创建空文件；文件已存在返回 false
native func bool createNewFile()

# 重命名/移动到目标路径，成功返回 true
native func bool renameTo(File dest)

# ---------- 文本读写 ----------

# 读取全部文本；文件无法打开时返回 null（空文件返回空串）
native func String readText()

# 覆盖写入文本，成功（可打开）返回 true
native func bool writeText(String content)

# 追加写入文本，成功（可打开）返回 true
native func bool appendText(String content)

# 按行读取（去掉行尾 \n 与 \r\n 的 \r）；文件无法打开时返回长度为 0 的数组
native func String[] readLines()

# 列出目录下的文件/子目录名（不含 . 与 ..）；不是目录或无法打开时返回 null
native func String[] list()
