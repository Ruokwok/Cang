namespace cang/lang

# Class - 类信息对象（对应 Java 的 java.lang.Class，不含泛型）。
# 通过类字面量获取：Apple.class / String.class / int.class。
# 同一个类在程序中只有一个 Class 实例，因此可直接用 == 比较身份：
#   if (a.class == b.class) { ... }
# 类对象由编译器在 main 启动时统一创建，字段只读（私有），通过方法访问。
# 注意：Class 本身不可 new（_init 私有），也不表示数组类型。
class Class
    String _name
    String _simpleName
    Class _superClass
    int _typeId = -1

    _init() {
    }

    # 全名（命名空间用 '_' 连接，如 demo_Apple；与 Object.getClassName() 一致）
    func String getName() {
        return this._name
    }

    # 简单类名（如 Apple）
    func String getSimpleName() {
        return this._simpleName
    }

    # 父类 Class；Object、基本类型和 void 返回 null
    func Class getSuperclass() {
        return this._superClass
    }

    # 本类是否与 other 相同、或是 other 的父类/祖先。
    # 即 Animal.class.isAssignableFrom(Dog.class) == true。
    func bool isAssignableFrom(Class other) {
        Class current = other
        while (current != null) {
            if (current == this) {
                return true
            }
            current = current._superClass
        }
        return false
    }

    func String toString() {
        String n = this._name
        return "class " + n
    }

    # 反射构造：按本类的公开构造函数创建实例并返回 Object。
    # 要求类非 abstract、非私有构造，且存在参数个数与实参匹配的 init（或隐式零参构造）。
    # 无参版本调用零参构造；Object 版本调用单参构造；Object[] 版本按数组长度调用多参构造，
    # 空数组等价于零参构造。参数个数必须精确匹配，不使用默认参数值。
    # String.class / int.class 等特殊类字面量、以及无匹配构造的类 → 运行时错误。
    # Object 参数可放 String、类实例、数组或 Field.getObject 得到的 Boxed 基本类型；
    # 基本类型参数必须用 Boxed 传入，newInstance(1) 不是合法调用。
    # 构造函数参数支持基本类型、String、Object、数组和类引用；其他类型会被跳过。
    # 构造函数体抛出的异常正常传播（可被调用方 try/catch 捕获）。
    # 返回值用转型取回具体类型：var p = Point!$(Point.class.newInstance())
    native func Object newInstance()

    # 单参构造：arg 为构造函数唯一的 Object/引用参数；基本类型参数需先装箱。
    native func Object newInstance(Object arg)

    # 多参构造：args.length 决定构造函数参数个数，数组元素按位置对应构造参数。
    # 空 Object[] 调用零参构造；数组本身为 null → 运行时错误。
    native func Object newInstance(Object[] args)
