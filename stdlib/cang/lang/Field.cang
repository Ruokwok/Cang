namespace cang/lang

# Field - 对象字段反射访问器。构造时绑定目标对象，随后按字段名读写：
#   var f = new Field(point)
#   int v = f.getInt("x")            —— 按名字读基本类型字段
#   Object o = f.getObject("parent") —— 按名字读引用字段
#   String t = f.getType("x")        —— 字段类型名：基本类型返回 int/long/bool 等，
#                                       引用类型返回全限定名（同 Object.getClassName()）；
#                                       String 字段返回 "String"，数组字段返回 "Array"
# 基本类型字段经 getObject 返回装箱对象（cang_lang_Boxed）。
# 类型安全：getInt 等要求字段实际类型匹配，不符 → 运行时错误；
# 字段不存在 / 目标对象为 null → 运行时错误（错误行号即调用点）。
class Field
    Object target

init(Object obj) {
    this.target = obj
}

native func Object getObject(String name)

# String 字段直接按原类型读取
native func String getString(String name)

# 基本类型读取：字段实际类型必须匹配方法对应的基本类型，否则运行时错误
native func int getInt(String name)
native func long getLong(String name)
native func byte getByte(String name)
native func bool getBool(String name)
native func float getFloat(String name)
native func double getDouble(String name)

# 字段类型名：int/long/byte/bool/float/double；引用类型返回类的全限定名
native func String getType(String name)

# 列出目标对象的全部字段名（声明顺序：先父类字段后本类字段；不含编译器占位）。
# 返回 String[] 快照，可直接 for-each / length() / 下标访问：
#   String[] names = f.list()
#   for (String n : names) { Stdout.println(n + " = " + f.getType(n)) }
# 目标对象为 null → 运行时错误（同其他访问器）。
native func String[] list()

# ---------- 按名写字段（setter）----------
# 类型安全：要求字段实际类型与 setter 匹配，不符 → 运行时错误；
# 字段不存在 / 目标为 null → 运行时错误。返回 void。
# setObject 用于引用字段（String/类实例/数组）；基本类型请用对应的 setInt/setLong/...

native func void setInt(String name, int value)
native func void setLong(String name, long value)
native func void setByte(String name, byte value)
native func void setBool(String name, bool value)
native func void setFloat(String name, float value)
native func void setDouble(String name, double value)

# String 字段写入
native func void setString(String name, String value)

# 引用字段写入（String / 类实例 / 数组；值可为 null）。基本类型字段请用对应的基本类型 setter。
native func void setObject(String name, Object value)
