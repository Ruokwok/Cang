namespace cang/lang

# String - 字符串类
# 编译器内置，无需 import
class String
    String s = '';

    init() {
    }

    init(String s) {
        this.s = s;
    }

# 字符串长度
native func int length()

# 是否以指定前缀开始
native func bool startsWith(String prefix)

# 是否以指定后缀结束
native func bool endsWith(String suffix)

# 查找子串位置，未找到返回 -1
native func int indexOf(String substring)

# 截取子串 [start, end)
native func String substring(int start, int end)

# 转为大写
native func String toUpper()

# 转为小写
native func String toLower()

# 去除首尾空白
native func String trim()

# 截取 index 处的单字节字符（UTF-8 字节粒度；结构扫描按 ASCII 比较即可），越界运行时错误
native func String charAt(int index)

# 读取 index 处的原始字节值（0..255，UTF-8 字节粒度）。
# 不调用 strlen、不分配内存，适合 O(n) 扫描（JSON/词法分析等热路径）；
# 调用方必须保证 0 <= index < length()——上界不检查，越界行为未定义。
# 负下标抛运行时错误。
native func int byteAt(int index)

# 字面全量替换：from 出现处全部换成 to；from 为空运行时错误；插入内容不重扫描（to 含 from 不死循环）
native func String replace(String from, String to)

# 按字面分隔符切分（Java 语义：丢弃尾部空段；中间空段保留；空串 → 空数组）。
# 分隔符为空运行时错误。返回 String[]（字节粒度，同 charAt）
native func String[] split(String sep)

# 由 Unicode 码点构造字符串（UTF-8 编码；JSON \uXXXX 反解：代理对先合成标量再传入）。
# 范围 [0, 0x10FFFF]，越界运行时错误。
static native func String fromCodePoint(int codePoint)

# double 的最短往返十进制表示（%.15g→%.17g 逐档 + strtod 回验，首个回验通过即输出）。
# NaN/±Infinity 返回 "null"（JSON 语义）；JSON 数字序列化用它（+ 拼接的 %g 只有 6 位精度）。
static native func String fromDouble(double d)

# 查找第一次出现的位置（忽略大小写）
native func int indexOfIgnoreCase(String substring)

# 转为整数，必须是完整合法数字（失败运行时错误；超出 int 范围也报错）
native func int parseInt()

# 转为 64 位整数（失败运行时错误）
native func long parseLong()

# 转为浮点数（支持 1.5 / 1e3 / .5 形式，失败运行时错误）
native func double parseDouble()
