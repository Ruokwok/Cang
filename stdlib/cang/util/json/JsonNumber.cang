namespace cang/util/json

# JsonNumber - JSON number
# 内部同时保存 long（整数值）与 double（浮点值）：
# - new JsonNumber(42) / new JsonNumber(42L) 走整数语义，序列化输出十进制整数；
# - new JsonNumber(1.5) 走浮点语义，序列化使用 String.fromDouble 的最短往返表示；
# - JsonNumber.parse(raw) 由解析器使用，保留原始文本（raw），避免超大整数丢精度；
# - NaN / Infinity 不是合法 JSON，writer 会输出 null（与 String.fromDouble 语义一致）。

import cang/util/json/JsonException
import cang/util/json/JsonValue

class JsonNumber : JsonValue
    double dbl = 0.0;
    long lng = 0L;
    bool integral = false;
    String raw = null;

    init(int value) {
        this.lng = value
        this.dbl = value
        this.integral = true
    }

    init(long value) {
        this.lng = value
        this.dbl = value
        this.integral = true
    }

    init(double value) {
        this.dbl = value
        this.integral = false
    }

    func int type() {
        return JsonValue.TYPE_NUMBER
    }

    func bool isIntegral() {
        return this.integral
    }

    func long longValue() {
        return this.lng
    }

    func double doubleValue() {
        return this.dbl
    }

    # 解析器产生的原始数字文本；手工构造返回 null
    func String rawText() {
        return this.raw
    }

    func long asLong() {
        if (this.integral) {
            return this.lng
        }
        return long!$(this.dbl)
    }

    func int asInt() {
        if (this.integral) {
            if (this.lng < -2147483648L || this.lng > 2147483647L) {
                throw new JsonException("JSON number is out of int range: " + this.text())
            }
            return int!$(this.lng)
        }
        return int!$(this.dbl)
    }

    func double asDouble() {
        return this.dbl
    }

    func String text() {
        if (this.raw != null) {
            return this.raw
        }
        if (this.integral) {
            return String!$(this.lng)
        }
        return String.fromDouble(this.dbl)
    }

    # 从合法 JSON 数字文本构造；非法文本抛 JsonException。
    # raw 原样保留，writer 优先输出它（大整数不丢精度）。
    static func JsonNumber parse(String text) {
        JsonNumber.validate(text)
        JsonNumber n = new JsonNumber(0)
        n.raw = text
        bool decimal = false
        int i = 0
        int len = text.length()
        while (i < len) {
            int b = text.byteAt(i)
            if (b == 46 || b == 101 || b == 69) {
                decimal = true
            }
            i = i + 1
        }
        if (decimal) {
            n.integral = false
            n.dbl = text.parseDouble()
        } else {
            # parseLong 在溢出时不保证抛错（可能饱和/截断），用十进制回写比对判断是否真的在
            # long 范围内；raw 已保留，退化后 writer 仍输出原始文本。
            long parsed = text.parseLong()
            String canonical = String!$(parsed)
            if (canonical == text || (parsed == 0L && text == "-0")) {
                n.lng = parsed
                n.integral = true
                n.dbl = parsed
            } else {
                n.integral = false
                n.dbl = text.parseDouble()
            }
        }
        return n
    }

    static func JsonNumber ofInt(int value) {
        return new JsonNumber(value)
    }

    static func JsonNumber ofLong(long value) {
        return new JsonNumber(value)
    }

    static func JsonNumber ofDouble(double value) {
        return new JsonNumber(value)
    }

    # 严格校验 RFC 8259 number 语法
    static func void validate(String text) {
        if (text == null || text.length() == 0) {
            throw new JsonException("Invalid JSON number: empty")
        }
        int len = text.length()
        int i = 0
        int b = text.byteAt(0)
        if (b == 45) {
            i = i + 1
            if (i >= len) {
                throw new JsonException("Invalid JSON number: " + text)
            }
            b = text.byteAt(i)
        }
        if (b == 48) {
            i = i + 1
        } else if (b >= 49 && b <= 57) {
            while (i < len) {
                b = text.byteAt(i)
                if (b >= 48 && b <= 57) {
                    i = i + 1
                } else {
                    break
                }
            }
        } else {
            throw new JsonException("Invalid JSON number: " + text)
        }
        if (i < len && text.byteAt(i) == 46) {
            i = i + 1
            if (i >= len || !JsonNumber._digit(text.byteAt(i))) {
                throw new JsonException("Invalid JSON number: " + text)
            }
            while (i < len && JsonNumber._digit(text.byteAt(i))) {
                i = i + 1
            }
        }
        if (i < len) {
            b = text.byteAt(i)
            if (b == 101 || b == 69) {
                i = i + 1
                if (i < len) {
                    b = text.byteAt(i)
                    if (b == 43 || b == 45) {
                        i = i + 1
                    }
                }
                if (i >= len || !JsonNumber._digit(text.byteAt(i))) {
                    throw new JsonException("Invalid JSON number: " + text)
                }
                while (i < len && JsonNumber._digit(text.byteAt(i))) {
                    i = i + 1
                }
            }
        }
        if (i != len) {
            throw new JsonException("Invalid JSON number: " + text)
        }
    }

    static func bool _digit(int b) {
        return b >= 48 && b <= 57
    }
