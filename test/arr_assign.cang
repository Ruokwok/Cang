class Test()

# Array element assignment
int[] arr = [1, 2, 3]
Stdout.print(arr[0])   # 1

arr[0] = 100
Stdout.print(arr[0])   # 100

arr[2] = 999
Stdout.print(arr[2])   # 999

# In loop
for (int i = 0; i < 3; i++) {
    arr[i] = i * 10
}
Stdout.print(arr[0])   # 0
Stdout.print(arr[1])   # 10
Stdout.print(arr[2])   # 20

# String array
String[] names = ["a", "b", "c"]
names[1] = "bb"
Stdout.print(names[1])  # bb
