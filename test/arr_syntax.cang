# 新数组语法测试
class Test()

# 1. 固定长度：int[10] arr = []; 长度 10，零填充
int[10] z = []
for (int i = 0; i < 10; i++) {
    Stdout.println(z[i])
}
z[0] = 42
Stdout.println(z[0])
Stdout.println(z[9])

# 1b. 固定长度：无初始化器 → 全 0
int[3] noint
Stdout.println(noint[2])

# 2. int[]：从字面量推导长度 3
int[] arr = [1, 2, 3]
Stdout.println(arr[0])
Stdout.println(arr[1])
Stdout.println(arr[2])

# 3. var：类型 + 长度都推导
var v = [1, 2, 4, 3]
Stdout.println(v[0])
Stdout.println(v[3])

# 4. 旧语法仍可用
int[] inferredAgain = [1, 2, 3]
Stdout.println(inferredAgain[2])

# 5. 固定数组 + 字面量初始化（长度校验通过）
int[3] f = [7, 8, 9]
Stdout.println(f[1])

# 6. String 数组
String[2] s = ["hello", "world"]
Stdout.println(s[1])

# 7. for-each 遍历固定数组
for (int x : f) {
    Stdout.println(x)
}
