class Main()
# array for-each with per-iteration local: 100k allocas must be reclaimed
int[100000] a = []
int cnt = 0
for (int v : a) {
    int j = v
    cnt = cnt + 1
}
Stdout.println(cnt)

# list for-each: loop-var alloca is inside the body (per iteration) + user local
List<int> xs = new List<>()
int m = 0
while (m < 100000) {
    xs.add(m)
    m = m + 1
}
int lcnt = 0
for (var v : xs) {
    int j = v
    lcnt = lcnt + 1
}
Stdout.println(lcnt)

# break inside list for-each (was silently a no-op before)
int b = 0
for (var v : xs) {
    b = b + 1
    if (b == 3) { break }
}
Stdout.println(b)
