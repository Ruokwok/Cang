class Main()
# while with per-iteration local: 3M allocas must be reclaimed each iteration
int i = 0
while (i < 3000000) {
    int j = i
    i = i + 1
}
Stdout.println(i)

# for with per-iteration local
int n = 0
for (int k = 0; k < 2000000; k++) {
    int j = k
    n = n + 1
}
Stdout.println(n)

# break/continue still route correctly through the cleanup label
int t = 0
for (int c = 0; c < 100; c++) {
    if (c == 5) { continue }
    if (c == 10) { break }
    t = t + 1
}
Stdout.println(t)
