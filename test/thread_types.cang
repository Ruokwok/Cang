func void hi() { Stdout.println("hi-from-void") }
func String msg() { return "from-thread" }
func double half(double x) { return x / 2.0 }
func int greet(String s) { Stdout.println(s) return 7 }

Thread<Void> a = Thread.spawn(hi)
a.join()
Thread<String> b = Thread.spawn(msg)
Stdout.println(b.join())
Thread<double> c = Thread.spawn(half, 5.0)
Stdout.println(c.join())
Thread<int> d = Thread.spawn(greet, "param-ok")
Stdout.println(d.join())